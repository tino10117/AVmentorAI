# AV MentorAI — Variables de entorno
# Copiá este archivo como .env en desarrollo local

# OpenAI API Key (obligatorio)
OPENAI_API_KEY=sk-...

# JWT Secret — cambiá esto por una cadena larga y aleatoria
JWT_SECRET=av-mentorai-super-secret-2024-change-this

# ── EJEMPLOS DE CONEXIÓN A BASE DE DATOS ──────────

# OPCIÓN A: Supabase (recomendado para empezar gratis)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...

# OPCIÓN B: Vercel KV (más simple, sin SQL)
# KV_URL=redis://...
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# OPCIÓN C: PlanetScale / MySQL
# DATABASE_URL=mysql://user:pass@host/db
